# Supabase (서버 전용 — 클라이언트에 노출되지 않음)
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인
# 로컬: 이 파일을 .env.local 로 복사해 값 입력 / 배포: Vercel 프로젝트 환경 변수에 등록
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kajabi 뉴스레터 (서버 전용)
# 기록 저장 폼의 (Optional) 동의에 체크한 사람만 Kajabi 폼 2149717545 로 보낸다.
# 비어 있으면 호출을 건너뛴다 (로컬·프리뷰에서 실제 구독이 생기지 않게 하려는 것이다).
# 값은 Kajabi 대시보드 > Settings > Public API 에서 발급 (Owner·Subowner 만 가능)
KAJABI_CLIENT_ID=
KAJABI_CLIENT_SECRET=

# GA4 (서버 전용) — 슬랙 리포트의 '홈 방문자 수'를 읽는 데만 쓴다.
# 세 값이 비어 있으면 그 줄만 빼고 리포트가 나간다.
# GA4_PROPERTY_ID: GA4 관리 > 속성 세부정보의 숫자 ID
# 서비스 계정: Google Cloud 에서 발급한 뒤, 그 이메일을 GA4 속성에 '뷰어'로 추가해야 한다.
# GA4_PRIVATE_KEY: 서비스 계정 JSON 의 private_key 값 (줄바꿈은 \n 그대로 둔다)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
