# Supabase (서버 전용 — 클라이언트에 노출되지 않음)
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인
# 로컬: 이 파일을 .env.local 로 복사해 값 입력 / 배포: Vercel 프로젝트 환경 변수에 등록
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kajabi 뉴스레터 (서버 전용)
# 기록 저장 폼의 (Optional) 동의에 체크한 사람만 Kajabi 폼 2149717545 로 보낸다.
# 아래 둘 중 하나만 채우면 된다. 아무것도 없으면 호출을 건너뛴다
# (로컬·프리뷰에서 실제 구독이 생기지 않게 하려는 것이다).

# (1) 정석 — 만료 전에 토큰을 스스로 새로 받는다. 둘 다 있으면 이쪽을 쓴다.
#     값은 Kajabi 대시보드 > Settings > Public API (Owner·Subowner 만 발급 가능)
KAJABI_CLIENT_ID=
KAJABI_CLIENT_SECRET=

# (2) 대체 — 이미 발급받은 액세스 토큰을 그대로 쓴다. 위 (1)이 없을 때만 쓰인다.
#     스스로 갱신하지 못해 만료되면 연동이 멈추므로, (1)을 쓸 수 있으면 이 값은 지운다.
KAJABI_API_TOKEN=
